<Project Sdk="Microsoft.NET.Sdk">


	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeviceListenerChanged" Version="1.0.4" />
  </ItemGroup>

	<PropertyGroup>
		<PackageId>HidWin</PackageId>
		<Version>1.0.1</Version>
		<Authors>TailsGhost</Authors>
		<Description>Библиотека для работы с Hid.</Description>
		<PackageProjectUrl>https://github.com/tailsghost/HidWin</PackageProjectUrl>
		<RepositoryUrl>https://github.com/tailsghost/HidWin</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
	</PropertyGroup>

</Project>
